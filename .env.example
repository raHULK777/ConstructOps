# ---------------------------------------------------------------------------
# ConstructOps Engine - environment contract
# Copy to .env and fill in real values. Boot aborts if a required value is
# missing or malformed (see src/config/env.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# PostgreSQL - must be a reachable cluster with the migrations applied.
DATABASE_URL=postgresql://constructops:constructops@localhost:5432/constructops

# Redis - tenant metadata cache. The API degrades to direct DB reads if down.
REDIS_URL=redis://localhost:6379

# Auth - HS256. Minimum 32 characters, use 64+ random characters in production.
# Access tokens are deliberately short-lived; refresh tokens rotate per use.
JWT_SECRET=replace_with_a_64_character_high_entropy_alphanumeric_hmac_secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=constructops
JWT_AUDIENCE=constructops-api
REFRESH_TOKEN_TTL_DAYS=30

# Password-reset links. When APP_PORTAL_URL is set it is used for links
# (required for the local Docker demo); otherwise production links use the
# tenant's own domain.
APP_PORTAL_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=60
# console = write emails (and reset links) to the log. none = drop them.
# Production defaults to none so tokens never reach production logs.
MAIL_TRANSPORT=console

# Root domain used to infer subdomains (alpha-builders.constructops.io -> alpha-builders).
# Custom domains are always matched exactly regardless of this value.
PLATFORM_ROOT_DOMAIN=constructops.io

# Express "trust proxy" setting: false | true | integer hop count | loopback,linklocal...
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API (empty = no CORS headers).
CORS_ORIGINS=

# Rate limiting (milliseconds / requests per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Password hashing cost (10-15). Lower only in tests.
BCRYPT_ROUNDS=12

# Tenant metadata cache TTL in seconds.
TENANT_CACHE_TTL_SECONDS=3600

# Password used by `npm run seed` for every demo account.
SEED_PASSWORD=ChangeMe!123
