# ---- build: full toolchain (also used by the compose "api-setup" migration job)
FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY portal/package.json ./portal/package.json
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY scripts ./scripts
COPY migrations ./migrations

RUN npm run build

# ---- runtime: production dependencies and compiled output only
FROM node:24-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080

COPY package.json package-lock.json ./
COPY portal/package.json ./portal/package.json
# The API does not need the portal's runtime dependencies.
RUN npm ci --omit=dev --workspaces=false --no-audit --no-fund

COPY --from=build /app/dist ./dist
COPY --from=build /app/migrations ./migrations

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["node", "dist/server.js"]
