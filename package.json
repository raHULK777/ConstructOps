{
  "name": "constructops-core",
  "version": "1.0.0",
  "private": true,
  "description": "ConstructOps Engine - multi-tenant, white-label construction operations platform (Express + TypeScript + PostgreSQL + Redis)",
  "license": "UNLICENSED",
  "workspaces": [
    "portal"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "onboard": "tsx scripts/onboard.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dev:memory": "tsx scripts/dev-inmemory-api.ts",
    "portal:dev": "npm run dev -w @constructops/portal",
    "portal:build": "npm run build -w @constructops/portal",
    "portal:start": "npm run start -w @constructops/portal",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
